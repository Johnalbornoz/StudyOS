          },
          {
            "text": "El registro de temperatura durante una observación",
            "isKey": false,
            "misconception": "FOCUSES_ON_MINOR_DETAIL",
            "rationale": "La temperatura es un detalle específico de la visita, no el tema completo del párrafo."
