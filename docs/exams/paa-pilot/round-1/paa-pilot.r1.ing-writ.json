          {
            "text": "Neither the coach nor the players were ready for the final practice.",
            "isKey": true,
            "misconception": null,
            "rationale": "With “neither...nor,” the verb agrees with the subject closest to it. Here, “players” is plural, so “were” is correct."
          },
          {
            "text": "Neither the coach nor the players was ready for the final practice.",
            "isKey": false,
            "misconception": "INCORRECT_SUBJECT_VERB_AGREEMENT",
            "rationale": "The verb does not agree with the nearby plural noun “players.”"
          },
          {
            "text": "Neither the coach or the players were ready for the final practice.",
            "isKey": false,
            "misconception": "CONFUSES_CORRELATIVE_CONJUNCTIONS",
            "rationale": "“Neither” is correctly paired with “nor,” not with “or.”"
          },
          {
            "text": "Neither the coach nor the players were ready for their final practice.",
            "isKey": false,
            "misconception": "CHANGES_ORIGINAL_MEANING",
            "rationale": "This changes the meaning by suggesting that the practice belonged separately to each person rather than being one shared practice."
          }
        ],
        "evidenceQuote": null
