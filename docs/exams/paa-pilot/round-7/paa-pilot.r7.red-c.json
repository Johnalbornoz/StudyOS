        "difficulty": 3,
        "focus": "qué conector o transición une mejor dos oraciones numeradas según su relación lógica"
      },
      {
        "slot": "s2",
        "objectiveCode": "paa.red.cohesion",
        "conceptStableId": "write.cohesion-connectors",
        "difficulty": 3,
        "focus": "qué palabra o expresión evita mejor la repetición innecesaria de una palabra entre dos oraciones numeradas"
      },
      {
        "slot": "s3",
        "objectiveCode": "paa.red.cohesion",
        "conceptStableId": "write.cohesion-connectors",
        "difficulty": 4,
        "focus": "qué transición conviene al comienzo de una oración numerada para marcar contraste o consecuencia"
      },
      {
        "slot": "s4",
        "objectiveCode": "paa.red.elision",
