          },
          {
            "text": "Each of the volunteers have brought a torch.",
            "isKey": false,
            "misconception": "AGREES_WITH_NEARBY_PLURAL_NOUN",
            "rationale": "“Volunteers” is plural, but the main subject is “each,” which requires a singular verb."
          },
          {
            "text": "Each of the volunteer has brought a torch.",
            "isKey": false,
            "misconception": "USES_SINGULAR_AFTER_OF_THE",
