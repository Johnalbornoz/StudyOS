      {
        "slot": "s4",
        "stem": "¿Qué reordenamiento mejora la secuencia lógica de las oraciones del párrafo?",
        "options": [
          {
            "text": "Ubicar la oración (3) antes de la oración (2).",
            "isKey": true,
            "misconception": null,
            "rationale": "Primero se explican los colores de los contenedores y después los estudiantes pueden usarlos durante los recreos."
          },
          {
            "text": "Ubicar la oración (5) antes de la oración (4).",
            "isKey": false,
            "misconception": "ALTERA_SECUENCIA_DE_REGISTRO",
            "rationale": "El informe debe basarse en los resultados que los grupos registraron, por lo que conviene mantener primero la oración (4)."
