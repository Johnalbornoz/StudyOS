{
  "kind": "QB_POST_CANARY_FAMILY_ANALYSIS",
  "label": "OFFLINE DIAGNOSTIC -- validators revision 5 over the Canary's candidates -- IN-SAMPLE -- NOT certification evidence, NOT a rescore of the Canary -- DEV_TEST_CONTENT, RIGHTS_NOT_ESTABLISHED, NOT RELEASE CONTENT. One primary cause per slot, by the first rule that applies.",
  "rules": [
    {
      "cause": "OTHER",
      "code": "PROVIDER_TIMEOUT",
      "when": "no candidate: the generation call timed out"
    },
    {
      "cause": "GENERATOR_PROMPT",
      "code": "HARNESS_REFUSAL",
      "when": "no candidate: the harness refused the answer (roots or symbols written into the item, malformed stimulus)"
    },
    {
      "cause": "PARAMETER_POLICY",
      "code": "WRONG_KEY_ON_A_NON_CLEAN_PINNED_CASE",
      "when": "a wrong key (revision 5 KEY_CONTRADICTED, or the AI reviewer's own solution disagrees) where the pinned parameter left a vertex that is not a whole number or a half"
    },
    {
      "cause": "GENERATOR_PROMPT",
      "code": "WRONG_KEY",
      "when": "a wrong key on a clean case: the provider's arithmetic or expansion is wrong"
    },
    {
      "cause": "GENERATOR_PROMPT",
      "code": "CONSTRUCT_GIVEN_AWAY",
      "when": "the item hands over what it should ask for: the equation already factorised, both linear factors written out, the division named (validator construct FAIL, or AI CONSTRUCT_VALIDITY FAIL)"
    },
    {
      "cause": "TASK_FAMILY_SPEC",
      "code": "ASKS_A_QUANTITY_OUTSIDE_THE_CONSTRUCT",
      "when": "a line item that asks for y at a stated x: the family's evidence target allows it, the construct's vocabulary has no such quantity, so the item cannot be keyed or checked in the family's terms"
    },
    {
      "cause": "GENERATOR_PROMPT",
      "code": "ITEM_QUALITY",
      "when": "the AI reviewer failed or doubted response contract, learner quality, fairness, stimulus or construct (ambiguous stems, duplicated options, scaffolding that gives the method away)"
    },
    {
      "cause": "DIFFICULTY_PROFILE",
      "code": "BAND_NOT_REALISED",
      "when": "the only doubt of the AI reviewer is DIFFICULTY or PROFILE_FIDELITY: a correct item below its band or its paper"
    },
    {
      "cause": "VALIDATOR",
      "code": "VALIDATOR_ONLY",
      "when": "the AI reviewer passed every dimension and its solution agrees; the item was held back only by revision-4 findings (declaration quality, scenario similarity, a false key failure)"
    },
    {
      "cause": "OTHER",
      "code": "NOT_REVIEWED",
      "when": "a candidate the budget closed before review, with no finding above"
    }
  ],
