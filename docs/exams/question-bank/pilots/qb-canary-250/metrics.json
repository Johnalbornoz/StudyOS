      "definition": "Reviewed candidates the decision policy classified REJECTED."
    },
    "REVIEWER_FAILURES": {
      "source": "RUN_LOG + REVIEW_PARSER",
      "definition": "Candidates whose one review call gave no usable review: transport failure, rejected request, call never recorded, truncated answer, provider refusal, malformed answer, or an answer refused by the no-repair rule. Never counted as approved."
    },
    "ACADEMIC_FAILURES": {
      "source": "EITHER",
      "definition": "VALIDATOR: answer key FAILED or machine recomputation FAIL. AI_REVIEWER: ACADEMIC_CORRECTNESS = FAIL or the reviewer's own solution DISAGREES with the key. EITHER: the union."
    },
    "ANSWER_KEY_FAILURES": {
      "source": "EITHER",
      "definition": "VALIDATOR: answer key class FAILED. AI_REVIEWER: the reviewer's own solution DISAGREES with the key. EITHER: the union."
    },
    "CONSTRUCT_FAILURES": {
      "source": "EITHER",
      "definition": "VALIDATOR: construct preservation FAIL. AI_REVIEWER: CONSTRUCT_VALIDITY = FAIL. EITHER: the union."
    },
    "PROFILE_FAILURES": {
      "source": "EITHER",
      "definition": "VALIDATOR: profile compliance FAIL (including the item demand policy). AI_REVIEWER: PROFILE_FIDELITY = FAIL. EITHER: the union."
    },
    "STRUCTURAL_FAILURES": {
      "source": "EITHER",
      "definition": "VALIDATOR: structural FAIL. AI_REVIEWER: RESPONSE_CONTRACT = FAIL. EITHER: the union."
    },
    "MATERIAL_DUPLICATES": {
      "source": "VALIDATOR",
      "definition": "Candidates whose originality outcome is not PASS_LOW_SIMILARITY: textual similarity, the same parameter set, a shared defining parameter pair or a near-duplicate scenario, against the other fresh candidates and every QB-R2D and QB-R2E candidate. The reviewer's ORIGINALITY verdict is reported beside it and is not part of this count (the reviewer is shown no corpus)."
    },
    "GUIDANCE_FOLLOWED": {
      "source": "VALIDATOR-SIDE CHECK",
      "definition": "Candidates whose declared model uses the slot's pinned parameter values (and, for claim evaluation, keys the slot's verdict where a verdict is keyed)."
